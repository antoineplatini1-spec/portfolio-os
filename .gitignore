# Cache SEC EDGAR ticker→CIK (regénéré depuis la SEC, ~1 Mo)
data/edgar_ciks.json

# État du watcher de sorties (execId déjà notifiés par email) — local à chaque machine
data/notified_execs.json

# Journaux d'apprentissage/attribution — TRACKÉS (backup offsite GitHub).
# Le VPS est le SEUL à écrire dedans (les runs y tournent) → pas de conflit de merge.
# Petits (1 ligne / décision ou clôture, ~2-3 trades/j) → négligeable en taille. C'est
# tout l'historique de la boucle d'attribution : à ne PAS perdre si le VPS meurt.
# data/postmortems.jsonl    ← décommenté intentionnellement
# data/decisions_log.jsonl  ← idem

# IBKR — identifiants Gateway & état local du Gateway (NE PAS committer)
docker/.env
docker/ibc-settings/

# Logs locaux (chaque machine a les siens)
